# Postgres (producción/desarrollo: Neon; local: postgres instalado en el sandbox)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bi_ventas_dev"

# Base de datos usada solo al correr `npm test`
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bi_ventas_test"

# NextAuth
NEXTAUTH_SECRET="reemplazar-por-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Graph API (permisos de aplicación) — se completan en la Tarea 8
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_DRIVE_ID=""
MS_EXCEL_ITEM_ID=""

# Secreto para proteger el endpoint de sincronización diaria (/api/sync)
CRON_SECRET="reemplazar-por-un-valor-aleatorio-largo"

# Solo se usan una vez, al correr `npx prisma db seed` para crear la primera
# cuenta admin (Tarea 8). Después de eso, los usuarios se crean desde /admin/usuarios
# y estas variables se pueden borrar.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
