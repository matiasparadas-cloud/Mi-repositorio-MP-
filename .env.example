# Postgres (producción/desarrollo: Neon; local: postgres instalado en el sandbox)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bi_ventas_dev"

# Base de datos usada solo al correr `npm test`
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bi_ventas_test"

# NextAuth
NEXTAUTH_SECRET="reemplazar-por-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Link de OneDrive del Excel de ventas, compartido como "Cualquiera con el
# link puede ver". Decisión explícita del usuario: evitar registrar una app
# en Azure AD, a cambio de que el archivo sea accesible por link (sin login)
# para quien lo tenga. Ver docs/superpowers/guides/onedrive-linking.md.
ONEDRIVE_SHARE_URL=""

# Secreto para proteger el endpoint de sincronización diaria (/api/sync)
CRON_SECRET="reemplazar-por-un-valor-aleatorio-largo"

# Habilita /bootstrap (pantalla del navegador para crear la primera cuenta
# admin en producción, sin terminal). Se autodeshabilita apenas existe un
# usuario, así que este secreto puede quedar configurado sin riesgo — pero
# conviene borrarlo de Vercel una vez creada la cuenta, por prolijidad.
BOOTSTRAP_SECRET="reemplazar-por-un-valor-aleatorio-largo"

# Alternativa para desarrollo local: correr `npx prisma db seed` con estas
# variables crea el primer admin sin pasar por el navegador. No se usa en
# producción (ahí se usa /bootstrap).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
